rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────── Вспомогательные функции ─────────────
    // Работник — это Firebase-аккаунт с ПОДТВЕРЖДЁННЫМ Email и документом users/{email}.
    // Подтверждение Email обязательно: без него любой мог бы зарегистрироваться под чужим адресом.

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function me() {
      return request.auth.token.email.lower();
    }
    function meRef() {
      return /databases/$(database)/documents/users/$(me());
    }
    // «активный»: профиль есть, подтверждён администратором, не заблокирован
    function isActive() {
      return signedIn()
        && exists(meRef())
        && get(meRef()).data.status == 'active'
        && get(meRef()).data.get('blocked', false) != true;
    }
    function isAdmin() {
      return isActive() && get(meRef()).data.role == 'admin';
    }

    // «Версия приложения разрешена администратором»: пока в config/app не включена блокировка (enforce) — всем можно.
    // Когда включена — только тем, чей телефон записал в users/{я}.appBuild версию не ниже config/app.minBuild
    // и которой нет в списке config/app.blockedBuilds. Старые версии (до 2.30.0) appBuild не пишут — закрываются сами.
    function versionOk() {
      let cfgPath = /databases/$(database)/documents/config/app;
      return !exists(cfgPath)
        || get(cfgPath).data.get('enforce', false) != true
        || (get(meRef()).data.get('appBuild', 0) >= get(cfgPath).data.get('minBuild', 0)
            && !(get(meRef()).data.get('appBuild', 0) in get(cfgPath).data.get('blockedBuilds', [])));
    }
    function isCurrent() {
      return isActive() && versionOk();
    }

    // ───────────── Работники ─────────────
    match /users/{id} {
      // Публичное чтение users/{id} УДАЛЕНО: раньше любой без входа мог прочитать passHash по Email.

      allow get: if signedIn() && (id == me() || isActive());
      allow list: if isActive();

      // регистрация: только свой документ, всегда worker / pending, без должности
      allow create: if signedIn() && id == me()
        && request.resource.data.role == 'worker'
        && request.resource.data.status == 'pending'
        && request.resource.data.get('position', '') == ''
        && request.resource.data.get('blocked', false) == false;

      // администратор меняет что угодно; работник — только своё и не роль/статус/должность/блокировку
      allow update: if isAdmin()
        || (signedIn() && id == me()
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['role', 'status', 'blocked', 'position', 'login', 'email']));
      allow delete: if isAdmin();
    }

    // ───────────── Настройки ─────────────
    match /config/{id} {
      // email администратора нужен новому работнику, чтобы создать задачу «подтвердить»
      allow get: if id == 'admin' && signedIn();
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // Настройки аккаунта (документ = логин; у администратора — «admin»). Читать можно у администратора: у всех те же настройки Диска.
    match /settings/{id} {
      allow read: if isActive() && (id == me() || id == 'admin');
      allow write: if isActive() && (id == me() || (id == 'admin' && isAdmin()));
    }

    // ───────────── Задачи и чат ─────────────
    match /tasks/{id} {
      allow read: if isCurrent();
      allow create: if isAdmin()
        || (signedIn() && id == ('approve_' + me()) && request.resource.data.type == 'approve');
      allow update: if isCurrent();
      allow delete: if isAdmin();
    }
    match /chat/{id} {
      allow read, write: if isCurrent();
    }

    // ───────────── Данные склада ─────────────
    match /products/{id}         { allow read, write: if isCurrent(); }
    match /receipts/{id}         { allow read, write: if isCurrent(); }
    match /shipments/{id}        { allow read, write: if isCurrent(); }
    match /wagen_ops/{id}        { allow read, write: if isCurrent(); }
    // черновики «Приём B-Ware» и «Инвентарь B-Ware» (чтобы незавершённая операция не пропадала при переустановке)
    match /bware_drafts/{id}     { allow read, write: if isCurrent(); }
    match /unload_ops/{id}       { allow read, write: if isCurrent(); }

    // Шаблоны накладных: создавать может любой активный (автораспознавание), править и удалять — администратор
    match /invoice_profiles/{id} {
      allow read, create: if isCurrent();
      allow update, delete: if isAdmin();
    }

    // всё остальное закрыто
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

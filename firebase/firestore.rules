rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────── Вспомогательные функции ─────────────
    // Работник — это Firebase-аккаунт с ПОДТВЕРЖДЁННЫМ Email и документом users/{email}.
    // Подтверждение Email обязательно: без него любой мог бы зарегистрироваться под чужим адресом.

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function me() {
      return request.auth.token.email.lower();
    }
    function meRef() {
      return /databases/$(database)/documents/users/$(me());
    }
    // «активный»: профиль есть, подтверждён администратором, не заблокирован
    function isActive() {
      return signedIn()
        && exists(meRef())
        && get(meRef()).data.status == 'active'
        && get(meRef()).data.get('blocked', false) != true
        && get(meRef()).data.get('strikes', 0) < 2;
    }
    // текст: только строка, без управляющих символов, не длиннее n
    function okText(v, n) {
      return v is string && v.size() <= n && !v.matches('(?s).*[\\x00-\\x08\\x0B\\x0C\\x0E-\\x1F].*');
    }
    function isAdmin() {
      return isActive() && get(meRef()).data.role == 'admin';
    }

    // «Версия приложения разрешена администратором»: пока в config/app не включена блокировка (enforce) — всем можно.
    // Когда включена — только тем, чей телефон записал в users/{я}.appBuild версию не ниже config/app.minBuild
    // и которой нет в списке config/app.blockedBuilds. Старые версии (до 2.30.0) appBuild не пишут — закрываются сами.
    function versionOk() {
      let cfgPath = /databases/$(database)/documents/config/app;
      return !exists(cfgPath)
        || get(cfgPath).data.get('enforce', false) != true
        || (get(meRef()).data.get('appBuild', 0) >= get(cfgPath).data.get('minBuild', 0)
            && !(get(meRef()).data.get('appBuild', 0) in get(cfgPath).data.get('blockedBuilds', [])));
    }
    function isCurrent() {
      return isActive() && versionOk();
    }

    // ───────────── Работники ─────────────
    match /users/{id} {
      // Публичное чтение users/{id} УДАЛЕНО: раньше любой без входа мог прочитать passHash по Email.

      allow get: if signedIn() && (id == me() || isActive());
      allow list: if isActive();

      // регистрация: только свой документ, всегда worker / pending, без должности, без passHash
      allow create: if signedIn() && id == me()
        && request.resource.data.role == 'worker'
        && request.resource.data.status == 'pending'
        && request.resource.data.get('position', '') == ''
        && request.resource.data.get('blocked', false) == false
        && request.resource.data.get('strikes', 0) == 0
        && !('passHash' in request.resource.data);

      // администратор меняет что угодно (в том числе снимает блок: strikes = 0);
      // работник — только своё и не роль/статус/должность/блокировку/счётчик/passHash;
      // отдельно: работник может только увеличить свой счётчик нарушений на 1 (максимум до 2)
      allow update: if isAdmin()
        || (signedIn() && id == me()
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['role', 'status', 'blocked', 'position', 'login', 'email', 'strikes', 'lastStrike', 'passHash']))
        || (signedIn() && id == me()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['strikes', 'lastStrike'])
            && request.resource.data.strikes == resource.data.get('strikes', 0) + 1
            && request.resource.data.strikes <= 2
            && request.resource.data.lastStrike is string
            && request.resource.data.lastStrike.size() <= 200);
      // удалять профиль может только администратор
      allow delete: if isAdmin();
    }

    // ───────────── Настройки ─────────────
    match /config/{id} {
      // email администратора нужен новому работнику, чтобы создать задачу «подтвердить»
      allow get: if id == 'admin' && signedIn();
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // Настройки аккаунта (документ = логин; у администратора — «admin»). Читать можно у администратора: у всех те же настройки Диска.
    match /settings/{id} {
      // ВРЕМЕННО: пока файлы работников не уходят администратору, работники читают settings/admin (там данные Диска).
      // Когда очередь «файлы → админ» заработает, заменить на: allow read: if isActive() && (id == me() || isAdmin());
      allow read: if isActive() && (id == me() || id == 'admin');
      allow write: if isActive() && (id == me() || (id == 'admin' && isAdmin()));
    }

    // ───────────── Задачи и чат ─────────────
    match /tasks/{id} {
      allow read: if isCurrent();
      allow create: if isAdmin()
        || (signedIn() && id == ('approve_' + me()) && request.resource.data.type == 'approve')
        // сообщение администратору о подозрительной записи (только от себя, только текст)
        || (isActive() && id.matches('sec_.*') && request.resource.data.type == 'security'
            && request.resource.data.createdBy == me()
            && okText(request.resource.data.get('text', ''), 500)
            && okText(request.resource.data.get('title', ''), 200));
      // задачи закрывают исполнитель или администратор; менять можно только статус
      allow update: if isAdmin()
        || (isCurrent() && resource.data.get('assignee', '') == me()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'doneAt', 'doneAuto', 'doneByName']));
      allow delete: if isAdmin();
    }

    // Чат: писать от своего имени, только текст ≤ 2000 символов, время ставит сервер.
    // Править: администратор — всегда; автор — своё сообщение в течение 3 минут. Удалять — только администратор.
    match /chat/{id} {
      allow read: if isCurrent();
      allow create: if isCurrent()
        && request.resource.data.from == me()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && me() in request.resource.data.participants
        && okText(request.resource.data.text, 2000)
        && request.resource.data.text.size() > 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['chatId', 'participants', 'from', 'fromName', 'to', 'text', 'ts', 'createdAt']);
      allow update: if isAdmin()
        || (isCurrent() && resource.data.from == me()
            && request.time < resource.data.createdAt + duration.value(3, 'm')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
            && okText(request.resource.data.text, 2000)
            && request.resource.data.text.size() > 0);
      allow delete: if isAdmin();
    }

    // ───────────── Данные склада ─────────────
    // читать и создавать/менять может любой работник с актуальной версией, УДАЛЯТЬ — только администратор
    match /products/{id} {
      allow read, create, update: if isCurrent();
      allow delete: if isAdmin();
    }
    match /receipts/{id} {
      allow read, create, update: if isCurrent();
      allow delete: if isAdmin();
    }
    match /shipments/{id} {
      allow read, create, update: if isCurrent();
      allow delete: if isAdmin();
    }
    match /wagen_ops/{id} {
      allow read, create, update: if isCurrent();
      allow delete: if isAdmin();
    }
    // черновики «Приём B-Ware» и «Инвентарь B-Ware»: черновик — рабочая запись, поэтому удалять его может и работник (после сохранения операции)
    match /bware_drafts/{id} {
      allow read, create, update, delete: if isCurrent();
    }
    match /unload_ops/{id} {
      allow read, create, update: if isCurrent();
      allow delete: if isAdmin();
    }

    // Шаблоны накладных: создавать может любой активный (автораспознавание), править и удалять — администратор
    match /invoice_profiles/{id} {
      allow read, create: if isCurrent();
      allow update, delete: if isAdmin();
    }

    // всё остальное закрыто
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

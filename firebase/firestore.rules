rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Вход в приложении сделан через коллекцию users (логин + хэш пароля), а не через Firebase Auth,
    // поэтому правила остаются открытыми. Закрыть их можно только после перехода на Firebase Auth.

    // Настройки приложения: config/admin = администратор настроен, одноразовый вход admin/admin удалён
    match /config/{id} {
      allow read, write: if true;
    }

    // Работники: логин, имя, должность, роль, статус (pending/active), хэш пароля
    match /users/{id} {
      allow read, write: if true;
    }

    // Задачи работникам (в приложении / текстом) и задачи подтверждения новых работников
    match /tasks/{id} {
      allow read, write: if true;
    }

    // Чат между работниками
    match /chat/{id} {
      allow read, write: if true;
    }

    // Каталог товаров
    match /products/{id} {
      allow read, write: if true;
    }

    // Приёмки (история)
    match /receipts/{id} {
      allow read, write: if true;
    }

    // Шаблоны накладных поставщиков
    match /invoice_profiles/{id} {
      allow read, write: if true;
    }

    // Посылки Post paket (данные с этикеток DHL)
    match /shipments/{id} {
      allow read, write: if true;
    }

    // Операции DHL Postwagen
    match /wagen_ops/{id} {
      allow read, write: if true;
    }

    // Выгрузка: палеты по типам, номер машины и прицепа
    match /unload_ops/{id} {
      allow read, write: if true;
    }

    // Настройки аккаунтов (документ = логин)
    match /settings/{id} {
      allow read, write: if true;
    }
  }
}
